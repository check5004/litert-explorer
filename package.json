{
  "name": "litert-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-worker.mjs && vite",
    "build": "node scripts/build-worker.mjs && tsc && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "assets": "node scripts/prepare-assets.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:integration": "node scripts/build-test-modules.mjs && node tests/semantic-integration.mjs && node tests/detection-integration.mjs",
    "test:python": "python -m unittest discover -s tests -p \"test_*.py\"",
    "verify:pages": "node scripts/verify-pages.mjs"
  },
  "dependencies": {
    "@litertjs/core": "2.5.3",
    "@huggingface/transformers": "3.7.2"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "playwright-core": "1.55.1",
    "@webgpu/types": "0.1.64",
    "sharp": "0.34.1"
  }
}
